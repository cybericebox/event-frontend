# Every key is required (no fallbacks); hosts are bare (no scheme).
NEXT_PUBLIC_MAIN_HOST=example.com
NEXT_PUBLIC_API_HOST=api.example.com
NEXT_PUBLIC_ID_HOST=id.example.com
NEXT_PUBLIC_ADMIN_HOST=admin.example.com
NEXT_PUBLIC_EXERCISES_HOST=exercises.example.com
# Event sites are <tag>.<NEXT_PUBLIC_EVENT_DOMAIN>
NEXT_PUBLIC_EVENT_DOMAIN=example.com
# Parent domain of the theme/consent cookies (shared by all apps)
NEXT_PUBLIC_COOKIE_DOMAIN=example.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_PARTNER_URL=https://ice.nure.ua/ua/
NEXT_PUBLIC_PARTNER_SITE_URL=https://nure.ua
NEXT_PUBLIC_WIREGUARD_INSTALL_URL=https://www.wireguard.com/install/
# Bot check and DoS protection. Local development: no provider, protection off.
# Provider: turnstile | recaptcha | none. The site key is required unless the provider is none.
NEXT_PUBLIC_CAPTCHA_PROVIDER=none
# NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# NEXT_PUBLIC_RECAPTCHA_ENTERPRISE=false
# on = the invisible client token on the first visit (needs a provider); off = nothing.
NEXT_PUBLIC_DOS_PROTECTION=off
# Optional
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# DEV_ALLOWED_ORIGINS=comma,separated,dev,origins
