# Copy to .env (.env.local) for local dev. DOMAIN and SUPPORT_EMAIL are required; the commented ones are optional.
# The one base domain: a bare lowercase host name (no scheme, port or path). Every host derives from it: DOMAIN, api./id./admin./exercises.DOMAIN,
# event sites <tag>.DOMAIN, cookies on DOMAIN. There are no per-host settings.
NEXT_PUBLIC_DOMAIN=cybericebox.example
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional
# NEXT_PUBLIC_SHOW_PARTNERS=true
# NEXT_PUBLIC_WIREGUARD_INSTALL_URL=https://www.wireguard.com/install/
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# DEV_ALLOWED_ORIGINS=comma,separated,dev,origins
# Container listeners (see README, "Container listeners and TLS"); all optional
# HTTP_PORT=3000
# HTTPS_PORT=8443
# TLS_CERT_FILE=/tls/tls.crt
# TLS_KEY_FILE=/tls/tls.key
# TLS_MIN_VERSION=1.2
# TLS_CLIENT_CA_FILE=/aop/ca.crt
# TLS_CLIENT_AUTH=require
# HEALTH_PORT=8081
# TLS_RELOAD_INTERVAL=60
